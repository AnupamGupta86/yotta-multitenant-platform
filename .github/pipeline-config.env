# Shared, non-secret runtime defaults consumed by GitHub Actions jobs.
CONTAINER_REGISTRY=ghcr.io
KIND_CLUSTER_NAME=yotta-platform
PLATFORM_NAMESPACE=platform
OBSERVABILITY_NAMESPACE=observability
# Shared platform releases (Platform Deployment)
KAFKA_RELEASE_NAME=kafka
LOGGING_RELEASE_NAME=logging
MONITORING_RELEASE_NAME=prometheus
GRAFANA_DASHBOARDS_RELEASE_NAME=grafana-dashboards
WEBSITE_IMAGE=website
WEBSITE_ORCHESTRATOR_IMAGE=website-orchestrator
HOSTING_PLATFORM_IMAGE=hosting-platform
FLUENTD_IMAGE_NAME=fluentd-loki
WEBSITE_ORCHESTRATOR_DEPLOYMENT=website-orchestrator
WEBSITE_ORCHESTRATOR_RELEASE_NAME=website-orchestrator
HOSTING_PLATFORM_DEPLOYMENT=hosting-platform
ORCHESTRATOR_TOKEN_SECRET=orchestrator-github-token
ORCHESTRATOR_SMTP_SECRET=orchestrator-smtp
KAFKA_SERVICE_NAME=kafka
KAFKA_FORWARD_LOCAL_PORT=19092
KAFKA_INTERNAL_PORT=19092
KAFKA_EXTERNAL_PORT=9092
HELM_VERSION=v3.17.3
PYTHON_VERSION=3.12
GO_VERSION=1.24.x
KUBECONFORM_VERSION=0.6.7
IMAGE_BUILD_PLATFORMS=linux/amd64,linux/arm64
KAFKA_CI_IMAGE=apache/kafka:4.4.0
POSTGRES_CI_IMAGE=postgres:16-alpine
PLATFORM_HELM_TIMEOUT=15m
SERVICE_HELM_TIMEOUT=10m
ROLLOUT_TIMEOUT=5m
AIOPS_IMAGE=aiops-pod-doctor
AIOPS_DEPLOYMENT=aiops-pod-doctor
AIOPS_NAMESPACE=aiops
AIOPS_GROK_SECRET=aiops-grok-api-key
AIOPS_SMTP_SECRET=aiops-smtp
AIOPS_REPORT_CRONJOB=aiops-pod-doctor-report
# Platform database (helm/database-helm, services/database): the platform naming list
DATABASE_NAMESPACE=platform-data
DATABASE_RELEASE_NAME=myyotta-postgresql
DATABASE_SERVICE_NAME=postgresql
DATABASE_NAME=myyotta_platform
DATABASE_USER=myyotta_app
DATABASE_IMAGE=myyotta-postgresql
DATABASE_SECRET=myyotta-postgresql-secret

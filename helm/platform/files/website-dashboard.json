{
  "title": "Yotta Website Platform",
  "uid": "yotta-websites",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "sample",
    "website-platform"
  ],
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate by tenant",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant) (rate(yotta_http_requests_total[5m]))",
          "legendFormat": "{{tenant}}",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP request rate by endpoint",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint) (rate(yotta_http_requests_total[5m]))",
          "legendFormat": "{{endpoint}}",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP request rate by status code",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(yotta_http_requests_total[5m]))",
          "legendFormat": "HTTP {{status}}",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "title": "Successful HTTP responses (%)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (tenant) (rate(yotta_http_requests_total{status=\"200\"}[5m])) / sum by (tenant) (rate(yotta_http_requests_total[5m]))",
          "legendFormat": "{{tenant}}",
          "format": "time_series"
        }
      ],
      "description": "Share of website requests returning HTTP 200. No data appears until requests have been made."
    },
    {
      "id": 5,
      "title": "Requests handled in the last 5 minutes",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant) (increase(yotta_http_requests_total[5m]))",
          "legendFormat": "{{tenant}}",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "title": "Website replicas: current and desired",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_horizontalpodautoscaler_status_current_replicas and on(namespace) kube_pod_container_info{container=\"website-app\"}",
          "legendFormat": "current {{namespace}}",
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas and on(namespace) kube_pod_container_info{container=\"website-app\"}",
          "legendFormat": "desired {{namespace}}",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 7,
      "title": "Website CPU usage by tenant",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (rate(container_cpu_usage_seconds_total{container=\"website-app\"}[5m]))",
          "legendFormat": "{{namespace}}",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 8,
      "title": "Website memory working set by tenant",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (container_memory_working_set_bytes{container=\"website-app\"})",
          "legendFormat": "{{namespace}}",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 9,
      "title": "Website container restarts (15m increase)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (increase(kube_pod_container_status_restarts_total{container=\"website-app\"}[15m]))",
          "legendFormat": "{{namespace}}",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 10,
      "title": "Ready PostgreSQL replicas by tenant",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (kube_statefulset_status_replicas_ready{statefulset=~\".+-postgres\", namespace!=\"platform\"})",
          "legendFormat": "{{namespace}}",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 11,
      "title": "Website application logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=~\"user1|user2|user3\", container=\"website-app\"}"
        }
      ]
    }
  ]
}
